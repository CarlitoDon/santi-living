{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "PROXY_API_SECRET",
    "SANTI_PROXY_URL",
    "SYNC_ERP_API_URL",
    "SYNC_ERP_API_SECRET",
    "MIDTRANS_CLIENT_KEY",
    "MIDTRANS_SERVER_KEY",
    "MIDTRANS_IS_PRODUCTION",
    "ERP_SYNC_SERVICE_URL",
    "BOT_SECRET",
    "GOOGLE_MAPS_API_KEY",
    "NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY",
    "NOTION_API_KEY",
    "NOTION_BLOG_DATABASE_ID",
    "NOTION_REVALIDATE_SECRET",
    "NOTION_WEBHOOK_VERIFICATION_TOKEN",
    "LEAD_EVENTS_ADMIN_TOKEN",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_HOST",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "PGHOST",
    "PGHOST_UNPOOLED",
    "PGDATABASE",
    "POSTGRES_DATABASE",
    "PGUSER",
    "PGPASSWORD",
    "NEON_PROJECT_ID",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "typecheck": {}
  }
}
